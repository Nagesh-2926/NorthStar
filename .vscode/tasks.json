{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: Start FastAPI",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["-m", "uvicorn", "backend.app.main:app", "--reload", "--host", "127.0.0.1", "--port", "8001"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Backend: Apply migrations",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["-m", "alembic", "-c", "backend\\alembic.ini", "upgrade", "head"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Frontend: Start Vite",
      "type": "process",
      "command": "npm",
      "args": ["run", "dev", "--", "--host=127.0.0.1", "--port=5173"],
      "options": { "cwd": "${workspaceFolder}\\frontend" },
      "problemMatcher": []
    },
    {
      "label": "Tests: Run backend and ML suite",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["-m", "pytest", "-q"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "ML: Retrain from OULAD",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["-m", "ml.supervised.train"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
