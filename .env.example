# Copy to .env and replace the placeholder secrets before starting services.
POSTGRES_DB=student_support
POSTGRES_USER=student_app
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://student_app:REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD@127.0.0.1:5432/student_support
JWT_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ACCESS_TOKEN_EXPIRE_MINUTES=30
COORDINATOR_INVITE_CODE=REPLACE_WITH_A_SEPARATE_RANDOM_INVITE_SECRET
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# LLM personalization is optional. Gemini credentials remain server-side.
# Set LLM_PROVIDER=gemini and configure GEMINI_API_KEY to enable Gemini.
# Leave LLM_PROVIDER=disabled to use the local supportive fallback.
LLM_PROVIDER=disabled
# Optional generic JSON-over-HTTP adapter settings (LLM_PROVIDER=http_json)
LLM_ENDPOINT=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional SMTP notifications. Delivery stays disabled until host and sender are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=8
